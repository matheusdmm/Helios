{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["server.ts", "lib/**/*.ts", "public/**/*.ts", "tests/**/*.ts"]
}
