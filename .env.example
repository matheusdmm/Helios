# IP do coletor S3-WIFI-ST na sua rede. Deixe vazio para prévia de exemplo.
S3_IP=
S3_USER=admin
# Senha da página do coletor. Em algumas versões, é a senha do Wi-Fi doméstico.
S3_PASSWORD=

# A dashboard escuta apenas neste computador por padrão.
HOST=127.0.0.1
PORT=3000
TIME_ZONE=America/Sao_Paulo

# Para instalar o webapp e abri-lo offline no celular, sirva por HTTPS
# com certificado confiável para o IP ou nome usado no celular.
# HTTPS_CERT=certs/helios.pem
# HTTPS_KEY=certs/helios-key.pem

TARIFF_BRL_PER_KWH=0
